{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eastcoastfoamllc",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "workers_dev": true,
  "previews": {},
  "routes": [
    { "pattern": "eastcoastfoamllc.com", "custom_domain": true },
    { "pattern": "www.eastcoastfoamllc.com", "custom_domain": true }
  ]
}
