---
import FutureLayout from '../layouts/FutureLayout.astro';
import FutureGuidedEstimate from '../components/FutureGuidedEstimate.astro';
import { futureContact } from '../data/future-content';
---
<FutureLayout title="Guided Estimate | East Coast Foam" description="Request an East Coast Foam estimate by sharing the project, property, timing, optional photos or plans, and contact preferences." estimatePage>
  <FutureGuidedEstimate />
  <section class="future-v1__estimate" aria-label="Direct estimate contact">
    <div>
      <p class="future-v1__kicker">Prefer to talk directly?</p>
      <h2>Call or email East Coast Foam.</h2>
      <p>The guided form sends the same project details to Casey's East Coast Foam inbox. You can also reach out directly at any time.</p>
    </div>
    <div class="future-v1__estimate-actions">
      <a class="future-v1__estimate-button" href={`mailto:${futureContact.publicEmail}?subject=Estimate%20request`}>Email East Coast Foam <span aria-hidden="true">→</span></a>
      <a href={`tel:${futureContact.phoneHref}`}>Call {futureContact.phoneDisplay}</a>
      <small>{futureContact.publicEmail}</small>
    </div>
  </section>
</FutureLayout>
