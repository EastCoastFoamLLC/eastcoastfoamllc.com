---
import FutureLayout from '../../layouts/FutureLayout.astro';
import assets from '../../data/site-assets.json';

const educationVisuals = {
  a1: '/media/education/visual-003/ecf-a1-v1-lowcountry-house-symptom-cutaway.webp',
  a2: '/media/education/visual-003/ecf-a2-v2-good-foam-vs-needs-inspection.webp',
  a3: '/media/education/visual-003/ecf-a3-v1-four-moisture-paths.webp',
  a4: '/media/education/visual-003/ecf-a4-v2-conditioned-attic-whole-system.webp',
  b1: '/media/education/visual-003/ecf-b1-v2-existing-foam-inspection-process.webp',
  b2: '/media/education/visual-003/ecf-b2-v4-repair-add-remove-leave-alone.webp',
  openClosed: '/media/education/visual-003/ecf-open-cell-vs-closed-cell-v1.webp',
  cost: '/media/education/visual-003/ecf-spray-foam-cost-factors-v1.webp',
  process: '/media/education/visual-003/ecf-before-during-after-installation-v4.webp',
  homebuyer: '/media/education/visual-003/ecf-homebuyer-existing-foam-checklist-v1.webp',
} as const;

const problems = [
  { label: 'Hot upstairs or uneven rooms', detail: 'Attic insulation, air leakage, ducts, HVAC balance and windows can all contribute.', href: '#start-here' },
  { label: 'Musty attic or crawl space', detail: 'Start with the moisture source before deciding what insulation work makes sense.', href: '#moisture' },
  { label: 'Condensation or dampness', detail: 'Humidity, cold surfaces, air leakage and active water can create similar symptoms.', href: '#moisture' },
  { label: 'Existing foam looks questionable', detail: 'Gaps, pull-away, inconsistent coverage or unusual material condition are worth inspecting.', href: '#existing-foam' },
  { label: 'Already have foam but comfort is poor', detail: 'The answer may be repair, another building system, or no additional foam at all.', href: '#second-opinion' },
  { label: 'Buying a home with spray foam', detail: 'Review the installation, documentation, water history and how the attic/crawl space is managed.', href: '#homebuyer' },
];

const signs = [
  ['01','Pull-away','Foam visibly separating from framing or sheathing.'],
  ['02','Gaps or voids','Visible substrate, missed corners or incomplete transitions.'],
  ['03','Inconsistent coverage','Areas that look substantially different from the intended continuous layer.'],
  ['04','Poor adhesion','Foam that appears detached or delaminated from the surface.'],
  ['05','Unusual material condition','Sticky, friable/crumbly or unusually discolored foam deserves a closer look.'],
  ['06','Persistent unusual odor','A continuing concern after installation should be investigated rather than dismissed.'],
  ['07','Humidity or moisture remains','A sealed-looking attic or crawl space can still have a moisture-management problem.'],
];

const moisturePaths = [
  ['Bulk water','Roof, flashing, plumbing or flooding.','Fix active water first.'],
  ['Ground / crawl moisture','Wet soil, standing water, drainage or vapor movement.','Insulation is only one part of the solution.'],
  ['Humid-air leakage','Moist air moving through gaps and penetrations.','Air sealing can matter as much as insulation.'],
  ['Condensation','Moist air meeting a cold surface.','Find the humidity and surface-temperature cause.'],
];

const reviewQuestions = [
  'Does this sound like how you explain the problem to customers?',
  'What do you actually check during another contractor’s spray-foam audit?',
  'Do you give customers photos, measurements, a written summary, or a verbal explanation?',
  'Which tools do you regularly use: moisture meter, RH meter, thermal camera, thickness checks?',
  'When will you repair another contractor’s foam, and when will you recommend removal or another trade?',
  'Do you want “Spray Foam Inspection / Second Opinion” marketed as its own service?',
];
---
<FutureLayout
  title="Homeowner Education Concept | East Coast Foam"
  description="Internal East Coast Foam concept preview for homeowner education and spray-foam second-opinion content."
  noindex
>
  <div class="concept-banner">
    <strong>Concept preview</strong>
    <span>Not public navigation · not final Casey-approved service language</span>
  </div>

  <section class="concept-hero" data-mobile-actions-anchor>
    <div class="concept-hero__copy">
      <p class="future-v1__kicker">Homeowner education concept</p>
      <h1>Start with what you're <em>noticing.</em></h1>
      <p class="concept-lede">You should not need to know the right insulation product before asking for help. Start with the symptom, understand the likely building-envelope questions, then decide what—if anything—needs to change.</p>
      <div class="concept-actions">
        <a class="future-v1__estimate-button" href="#start-here">What are you noticing? <span aria-hidden="true">↓</span></a>
        <a class="concept-text-link" href="#second-opinion">I already have spray foam →</a>
      </div>
      <div class="concept-trustline">
        <span>Problem first</span>
        <span>Plain English</span>
        <span>Inspect before assuming</span>
      </div>
    </div>
    <div class="concept-hero__media">
      <img src={assets.hero} alt="East Coast Foam spray foam installation work" />
      <div class="concept-hero__card">
        <span>Working idea</span>
        <strong>“Describe the problem. We can start there.”</strong>
      </div>
    </div>
  </section>

  <section class="concept-section concept-section--paper" id="start-here">
    <div class="concept-heading">
      <div>
        <p class="future-v1__kicker">Start here</p>
        <h2>What are you noticing?</h2>
      </div>
      <p>Different problems can look alike. These paths help a homeowner ask a useful question without pretending to diagnose the building from a website.</p>
    </div>
    <figure class="education-visual education-visual--feature">
      <img src={educationVisuals.a1} width="1672" height="941" loading="lazy" decoding="async" alt="Educational cutaway of a Lowcountry-style house showing attic heat, ductwork, possible water entry, wall condensation, crawl-space moisture, cold floors, and humid outdoor air as possible symptom paths." />
      <figcaption><strong>Educational illustration.</strong> A symptom is not a diagnosis. Hot rooms, dampness, odors, condensation, or comfort problems can involve more than insulation, so the useful first step is understanding where to look.</figcaption>
    </figure>
    <div class="problem-grid">
      {problems.map((problem) => (
        <a href={problem.href} class="problem-card">
          <span>{problem.label}</span>
          <p>{problem.detail}</p>
          <b aria-hidden="true">→</b>
        </a>
      ))}
    </div>
  </section>

  <section class="concept-section concept-section--dark" id="second-opinion">
    <div class="second-opinion">
      <div class="second-opinion__copy">
        <p class="future-v1__kicker">Confirmed ECF capability</p>
        <h2>Already have spray foam? Get a second opinion before assuming it all needs to come out.</h2>
        <p>East Coast Foam already audits and inspects spray-foam work installed by other contractors. The public service name, exact deliverables, and pricing still need Casey's approval—but the customer problem is real.</p>
        <blockquote>“An inspection should not start with the assumption that you need more foam.”</blockquote>
        <div class="second-opinion__outcomes">
          <span>Localized repair</span>
          <span>Complete a missed area</span>
          <span>Fix moisture first</span>
          <span>Call another trade</span>
          <span>Monitor / leave it alone</span>
          <span>Consider larger corrective work</span>
        </div>
      </div>
      <figure class="second-opinion__media">
        <img src={educationVisuals.b1} width="1672" height="941" loading="lazy" decoding="async" alt="Educational illustration of a spray-foam second-opinion process moving from homeowner concern through accessible visual inspection, documentation, explanation, and an appropriate next-step recommendation." />
        <figcaption><strong>Educational illustration.</strong> Example inspection flow; exact ECF tools and deliverables remain Casey-review items.</figcaption>
        <div>
          <small>Casey review needed</small>
          <strong>What does an ECF audit actually include?</strong>
          <p>Visual review, photos, thickness, moisture/RH, thermal imaging, written findings, repair scope—only the items Casey confirms should appear publicly.</p>
        </div>
      </figure>
    </div>
  </section>

  <section class="concept-section" id="existing-foam">
    <div class="concept-heading">
      <div>
        <p class="future-v1__kicker">Existing spray foam</p>
        <h2>Seven signs the installation deserves a closer look.</h2>
      </div>
      <p>These are inspection triggers, not automatic removal triggers.</p>
    </div>
    <figure class="education-visual">
      <img src={educationVisuals.a2} width="1672" height="941" loading="lazy" decoding="async" alt="Educational comparison showing continuous bonded-looking spray foam alongside pull-away, a missed framing transition, and a neutral irregular surface condition that may be worth inspecting." />
      <figcaption><strong>Educational illustration.</strong> These are examples of conditions worth inspecting, not proof that an installation has failed or must be removed.</figcaption>
    </figure>
    <div class="sign-grid">
      {signs.map(([num,title,detail]) => (
        <article class="sign-card">
          <span>{num}</span>
          <h3>{title}</h3>
          <p>{detail}</p>
        </article>
      ))}
    </div>
    <div class="concept-note">
      <strong>Education guardrail</strong>
      <p>Visible foam alone cannot prove installed R-value, code compliance, or the root cause of a moisture/comfort problem. The page should teach homeowners what is worth checking—not turn them into remote inspectors.</p>
    </div>
  </section>

  <section class="concept-section concept-section--moisture" id="moisture">
    <div class="concept-heading">
      <div>
        <p class="future-v1__kicker">Mold, moisture &amp; insulation</p>
        <h2>Four moisture paths. One simple rule: fix active water first.</h2>
      </div>
      <p>Mold and musty conditions are reasons to find the moisture source. Spray foam is not a mold treatment and is not a substitute for repairing a leak.</p>
    </div>
    <div class="moisture-grid">
      {moisturePaths.map(([title,detail,rule], index) => (
        <article>
          <span>0{index + 1}</span>
          <h3>{title}</h3>
          <p>{detail}</p>
          <strong>{rule}</strong>
        </article>
      ))}
    </div>
    <figure class="education-visual education-visual--feature">
      <img src={educationVisuals.a3} width="1672" height="941" loading="lazy" decoding="async" alt="Educational house diagram showing four moisture paths: bulk water, ground or crawl-space moisture, humid-air leakage, and condensation." />
      <figcaption><strong>Educational illustration.</strong> Moisture can arrive through different paths. Finding the source matters before deciding whether insulation work belongs in the solution.</figcaption>
    </figure>
  </section>

  <section class="concept-section concept-section--paper">
    <div class="conditioned-grid">
      <div>
        <p class="future-v1__kicker">Conditioned attic education</p>
        <h2>“Sprayed roof deck” and “well-managed conditioned attic” are related—but not identical.</h2>
        <p>A sealed attic still needs a moisture strategy. Water leaks, incomplete coverage, air pathways, ducts/HVAC, and how the attic is conditioned can all matter.</p>
        <ul>
          <li>Roof must still stay dry.</li>
          <li>The air/thermal boundary needs continuity.</li>
          <li>Moisture still needs a way to be controlled.</li>
          <li>One universal dehumidifier prescription does not fit every house.</li>
        </ul>
      </div>
      <figure class="education-visual conditioned-visual-image">
        <img src={educationVisuals.a4} width="1920" height="1080" loading="lazy" decoding="async" alt="Educational conditioned-attic cutaway showing roof and drainage, sheathing, spray-foam boundary, attic space with ducts and HVAC, moisture-management context, and living space below." />
        <figcaption><strong>Educational illustration.</strong> A sprayed roof deck is one part of a whole-system attic strategy; the illustration does not prescribe one universal conditioning or dehumidification design.</figcaption>
      </figure>
    </div>
  </section>

  <section class="concept-section" id="homebuyer">
    <figure class="education-visual education-visual--feature education-visual--homebuyer">
      <img src={educationVisuals.homebuyer} width="1376" height="768" loading="lazy" decoding="async" alt="Educational homebuyer checklist illustration covering where spray foam is installed, visible foam condition, moisture history, HVAC and whole-system context, transitions, and installation documentation or history." />
      <figcaption><strong>Educational illustration.</strong> A homebuyer review should consider installation location, visible condition, moisture history, whole-system context, transitions, and documentation—not just whether spray foam is present.</figcaption>
    </figure>
    <div class="homebuyer-grid">
      <div class="homebuyer-card">
        <p class="future-v1__kicker">Buying a home with spray foam?</p>
        <h2>Ask what was installed—not just whether foam is present.</h2>
        <ul>
          <li>Who installed it, and when?</li>
          <li>Open-cell or closed-cell?</li>
          <li>Product/manufacturer documentation?</li>
          <li>Where was it installed and why?</li>
          <li>Any roof, plumbing, flooding, or moisture history?</li>
          <li>Any visible gaps, pull-away, staining, or persistent odor?</li>
          <li>How is an unvented/conditioned attic managed?</li>
        </ul>
        <a class="concept-text-link" href="#second-opinion">Second-opinion service concept →</a>
      </div>
      <div class="repair-card">
        <p class="future-v1__kicker">Not every concern means removal</p>
        <h3>Repair, add to, remove—or leave it alone?</h3>
        <div class="decision-list">
          <span><b>Localized issue</b><small>Possible repair</small></span>
          <span><b>Incomplete coverage</b><small>Inspect / complete</small></span>
          <span><b>Active water</b><small>Fix source first</small></span>
          <span><b>Unusual material condition</b><small>Investigate corrective path</small></span>
          <span><b>Foam looks fine, comfort poor</b><small>Look beyond foam</small></span>
          <span><b>No actionable defect</b><small>Monitor / leave alone</small></span>
        </div>
        <figure class="education-visual education-visual--compact">
          <img src={educationVisuals.b2} width="1672" height="941" loading="lazy" decoding="async" alt="Educational decision-support illustration showing localized correction, completing missing coverage, fixing active water first, investigating unusual material, looking beyond foam to another system or trade, and monitoring or leaving acceptable conditions alone." />
          <figcaption><strong>Educational illustration.</strong> The appropriate next step, not the largest job.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="concept-section concept-section--paper" id="education-library">
    <div class="concept-heading">
      <div>
        <p class="future-v1__kicker">Homeowner education library</p>
        <h2>Useful comparisons without turning the website into a prescription.</h2>
      </div>
      <p>These accepted illustrations can help homeowners prepare better questions. Final public copy should stay assembly-specific, avoid universal thickness or re-entry rules, and avoid presenting generic illustrations as actual ECF job evidence.</p>
    </div>
    <div class="education-visual-grid">
      <figure class="education-visual-card">
        <img src={educationVisuals.openClosed} width="1672" height="941" loading="lazy" decoding="async" alt="Educational comparison of open-cell and closed-cell spray foam as different material options, without prescribing one material for every building assembly." />
        <figcaption><strong>Open-cell vs. closed-cell.</strong> Compare characteristics and project context rather than choosing solely from a headline R-value.</figcaption>
      </figure>
      <figure class="education-visual-card">
        <img src={educationVisuals.cost} width="1672" height="941" loading="lazy" decoding="async" alt="Educational spray-foam cost-factor illustration showing that project scope, access, assembly, preparation, material choice, and job conditions can affect a quote." />
        <figcaption><strong>What affects cost.</strong> Explain the factors that shape a quote without publishing a universal price or savings promise.</figcaption>
      </figure>
      <figure class="education-visual-card education-visual-card--wide">
        <img src={educationVisuals.process} width="1376" height="768" loading="lazy" decoding="async" alt="Educational before, during, and after installation illustration showing a general project sequence without prescribing universal re-entry timing or job-specific safety rules." />
        <figcaption><strong>Before / during / after.</strong> Set expectations about preparation, installation, cleanup, and documentation while keeping project-specific safety and re-entry guidance with the actual job instructions.</figcaption>
      </figure>
    </div>
  </section>

  <section class="concept-section concept-section--dark">
    <div class="questions-grid">
      <div>
        <p class="future-v1__kicker">Contractor education</p>
        <h2>A confident contractor can help you compare any quote.</h2>
        <p>The future education library should include a printable “questions to ask any insulation contractor” guide covering product, foam type, thickness, moisture, prep, quality checks, barriers/coatings, re-entry, documentation, warranty, and exclusions.</p>
      </div>
      <div class="question-prompt">
        <strong>Example homeowner question</strong>
        <p>“Why are you recommending this material for this assembly—not just because it has a higher R-value?”</p>
      </div>
    </div>
  </section>

  <section class="concept-section concept-review">
    <div class="concept-heading">
      <div>
        <p class="future-v1__kicker">Casey review packet</p>
        <h2>What we need to learn before this becomes public.</h2>
      </div>
      <p>The demo should make uncertain assumptions obvious so Casey can correct them quickly.</p>
    </div>
    <ol>
      {reviewQuestions.map((question) => <li>{question}</li>)}
    </ol>
    <div class="concept-review__actions">
      <a class="future-v1__estimate-button" href="/get-a-quote">See current Guided Estimate <span aria-hidden="true">→</span></a>
      <span>Future demo idea: add “I already have spray foam and want it checked.”</span>
    </div>
  </section>

  <section class="concept-footer-note">
    <strong>Concept status</strong>
    <p>This branch-preview page combines current research into one visual customer journey. After Casey review, accepted pieces should ship as smaller production releases—not as one giant content merge.</p>
  </section>
</FutureLayout>

<style>
